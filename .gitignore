# NUNCA subir datos reales de nómina al repositorio
nomina/inputs/*
nomina/outputs/*
!nomina/inputs/.gitkeep
!nomina/outputs/.gitkeep

# Secrets locales (passwords, claves)
nomina/.streamlit/secrets.toml
*.env

# Proyectos de video — assets pesados y deps
videos/*/node_modules/
videos/*/out/
videos/*/public/photos/*
videos/*/public/videos/*
videos/*/public/audio/*
!videos/*/public/**/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editores
.vscode/
.idea/
*.swp
.DS_Store

# Cosas temporales
*.tmp
nomina_*/
