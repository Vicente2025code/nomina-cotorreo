{
  "name": "pauline-video",
  "version": "1.0.0",
  "description": "Video de despedida para Pauline — 10 meses en Ciudad Quesada, Costa Rica. Vertical 9:16, hecho con Remotion.",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts PaulineVideo out/pauline.mp4",
    "build:hq": "remotion render src/index.ts PaulineVideo out/pauline.mp4 --codec h264 --crf 18 --image-format jpeg --concurrency 4",
    "build:square": "remotion render src/index.ts PaulineVideoSquare out/pauline-square.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.272",
    "@remotion/cli": "4.0.272",
    "@remotion/google-fonts": "4.0.272",
    "@remotion/media-utils": "4.0.272",
    "@remotion/renderer": "4.0.272",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.272"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
